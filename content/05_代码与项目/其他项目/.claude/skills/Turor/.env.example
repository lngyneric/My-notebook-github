# Google Gemini API Key
GEMINI_API_KEY=your_api_key_here

# Optional: Path to Knowledge Base Directory
# If not set, defaults to local path defined in code
# KB_PATH=/path/to/your/markdown/notes

# WeCom (Enterprise WeChat) Configuration
# Required for SSO
WECOM_CORP_ID=your_corp_id
WECOM_CORP_SECRET=your_corp_secret
WECOM_AGENT_ID=your_agent_id
